# ─────────────────────────────────────────────────────────────────────────────
# Catalyst Center MCP Server — Environment Configuration
#
# Copy this file to environment.env and fill in your values.
#   cp environment.example.env environment.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Catalyst Center Credentials (required) ───────────────────────────────────
# Base URL of your Catalyst Center appliance (no trailing slash)
CC_URL=https://your-catalyst-center.example.com

# Admin credentials with API access
CC_USER=admin
CC_PASS=your-password-here

# ── Local LLM Offloading (optional) ──────────────────────────────────────────
# When LOCAL_LLM_URL is set, large API responses are summarized by a local
# OpenAI-compatible LLM before being returned to Claude Desktop.
# This reduces token consumption and speeds up responses.
# Leave these commented out to disable local LLM offloading.

# URL of your local LLM (must expose the OpenAI /v1/chat/completions endpoint)
# LOCAL_LLM_URL=http://localhost:11434/v1

# API key — use any non-empty string if your server does not require one
# LOCAL_LLM_API_KEY=your-llm-api-key

# Model name as accepted by your LLM server (e.g. llama3, mistral, gemma3)
# LOCAL_LLM_MODEL=llama3
